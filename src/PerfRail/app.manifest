<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="PerfRail.app" />

  <!-- PerfRail deliberately runs as a standard user. Every metric it reports is
       obtainable without elevation; anything that would need a kernel driver is
       reported as unavailable instead. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Required for GetDpiForWindow and PerMonitorV2 to
           be honoured rather than silently downgraded. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- The AppBar rectangle handed to SHAppBarMessage is in physical pixels.
           Under anything less than PerMonitorV2 those coordinates get virtualized
           and the bar lands in the wrong place on any non-100% monitor.

           dpiAware is the legacy fallback for hosts that ignore dpiAwareness.
           Program.cs asserts Application.HighDpiMode at startup because a
           per-user AppCompatFlags\Layers override outranks this manifest and is
           writable without admin. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2,PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
