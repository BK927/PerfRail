<Project>

  <!-- Single source of truth for the version. Both the GitHub release build and
       the Store MSIX package derive from this, so the two distributions can
       never drift apart. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>PerfRail</Product>
    <Company>BK927</Company>
    <Authors>BK927</Authors>
    <Copyright>Copyright (c) 2026 BK927</Copyright>
    <RepositoryUrl>https://github.com/BK927/PerfRail</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
