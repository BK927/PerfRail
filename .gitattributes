# Normalize line endings so contributors on different platforms don't
# produce whitespace-only diffs.
* text=auto eol=lf

# Windows-native tooling that must keep CRLF
*.sln        text eol=crlf
*.props      text eol=crlf
*.targets    text eol=crlf
*.manifest   text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf
*.ps1        text eol=crlf

# Binary
*.png        binary
*.ico        binary
*.pfx        binary
*.snk        binary
